<%- | String               $prosa_name,
      String               $user = 'prosa',
      String               $group = 'prosa',
      Stdlib::Absolutepath $bin_path = '/usr/local/bin/prosa',
      Stdlib::Absolutepath $conf_path = '/etc/prosa',
      Optional[Integer]    $limit_nofile = undef,
      Boolean              $config_auto_reload = false,
| -%>
# Managed by Puppet. Changing config_auto_reload restarts ProSA.
# config_auto_reload=<%= $config_auto_reload %>
[Unit]
Description=ProSA service for <%= $prosa_name %>
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=<%= $user %>
Group=<%= $group %>
ExecStart=<%= $bin_path %> -c <%= $conf_path %>
Restart=on-failure
RestartSec=5
<% if $limit_nofile { -%>
LimitNOFILE=<%= $limit_nofile %>
<% } -%>

[Install]
WantedBy=multi-user.target
